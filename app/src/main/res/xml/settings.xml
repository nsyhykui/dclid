<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/cat_dhizuku">
        <Preference app:key="dhizuku_request" app:title="@string/dhizuku_request_title" app:summary="@string/dhizuku_request_summary" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/cat_server">
        <EditTextPreference app:key="bind_port" app:title="@string/bind_port_title" app:defaultValue="12345" />
        <EditTextPreference app:key="bind_ip" app:title="@string/bind_ip_title" app:defaultValue="0.0.0.0" />
        <SwitchPreferenceCompat app:key="service_switch" app:title="@string/service_switch_title" app:summary="@string/service_switch_summary" app:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/cat_security">
        <Preference app:key="auth_manage" app:title="@string/auth_manage_title" app:summary="@string/auth_manage_summary" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/cat_about">
        <Preference app:key="version" app:title="@string/version_title" app:summary="@string/version_summary" />
    </PreferenceCategory>
</PreferenceScreen>
